<div class="auth-container">
  <div class="auth-logo">Rails Task App</div>
  <p class="auth-sub">新しいアカウントを作成</p>

  <% if flash[:alert] %>
    <div class="flash flash-alert"><%= flash[:alert] %></div>
  <% end %>

  <% if @user.errors.any? %>
    <div class="error-messages">
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card">
    <h2 class="card-title">ユーザー登録</h2>
    <%# 確認画面は POST に対し別ページを 200 で描画するため、Turbo Drive を無効化してフルページ遷移にする。 %>
    <%= form_with(model: @user, url: signup_confirm_path, data: { turbo: false }) do |form| %>
      <div class="form-group">
        <%= form.label :name, "名前" %>
        <%= form.text_field :name, class: "form-input", placeholder: "山田太郎" %>
        <div class="hint">50文字以内</div>
      </div>
      <div class="form-group">
        <%= form.label :email, "メールアドレス" %>
        <%= form.email_field :email, class: "form-input", placeholder: "user@example.com" %>
      </div>
      <div class="form-group">
        <%= form.label :password, "パスワード" %>
        <%= form.password_field :password, class: "form-input", placeholder: "6文字以上" %>
      </div>
      <div class="form-group">
        <%= form.label :password_confirmation, "パスワード（確認）" %>
        <%= form.password_field :password_confirmation, class: "form-input", placeholder: "もう一度入力" %>
      </div>
      <%= form.submit "確認する", class: "btn btn-primary btn-block" %>
    <% end %>

    <hr class="divider">
    <p class="auth-switch">
      既にアカウントをお持ちの方は <%= link_to "ログイン", login_path %>
    </p>
  </div>
</div>
