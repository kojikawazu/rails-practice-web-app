<div class="auth-container">
  <div class="auth-logo">Rails Task App</div>
  <p class="auth-sub">入力内容の確認</p>

  <div class="card">
    <h2 style="font-size:18px; margin-bottom:20px;">この内容で登録しますか？</h2>

    <div style="display:grid; grid-template-columns:120px 1fr; gap:12px 16px; font-size:14px;">
      <div class="text-sub" style="font-weight:600;">名前</div>
      <div><%= @user.name %></div>

      <div class="text-sub" style="font-weight:600;">メールアドレス</div>
      <div><%= @user.email %></div>

      <%# パスワードは確認画面では表示せずマスクする（値は登録用に下記 hidden で保持）。 %>
      <div class="text-sub" style="font-weight:600;">パスワード</div>
      <div><%= "•" * 8 %></div>
    </div>

    <div class="flex gap-sm" style="margin-top:24px;">
      <%# 「修正する」: 入力値を confirm へ再送(back=1)し、入力フォームへ戻す（独立フォーム）。 %>
      <%# 学習用途のためパスワードも hidden で保持する（実運用では確認画面で再保持しない設計が望ましい）。 %>
      <%# Turbo Drive は非リダイレクトの 200 描画を破棄するため、確認画面のフォームはフルページ遷移にする。 %>
      <%= button_to "修正する", signup_confirm_path,
            method: :post,
            params: { user: { name: @user.name, email: @user.email,
                              password: @user.password, password_confirmation: @user.password_confirmation },
                      back: 1 },
            form: { data: { turbo: false } },
            class: "btn" %>

      <%# 「登録する」: signup(POST) = create で保存する。 %>
      <%= form_with(model: @user, url: signup_path, data: { turbo: false }) do |form| %>
        <%= form.hidden_field :name %>
        <%= form.hidden_field :email %>
        <%= form.hidden_field :password %>
        <%= form.hidden_field :password_confirmation %>
        <%= form.submit "登録する", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</div>
