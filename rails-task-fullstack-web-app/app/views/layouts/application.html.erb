<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rails Task App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "flatpickr", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if logged_in? %>
      <div class="app-frame">
        <nav class="sidebar">
          <div class="sidebar-header">Rails Task App</div>
          <div class="sidebar-nav">
            <%= link_to projects_path, class: "sidebar-item #{'active' if controller_name == 'projects' || controller_name == 'tasks'}" do %>
              Projects
            <% end %>
          </div>
          <div class="sidebar-footer">
            <div class="sidebar-user">
              <div class="avatar"><%= current_user.name.first %></div>
              <div>
                <div class="sidebar-user-name"><%= current_user.name %></div>
                <div class="sidebar-user-email"><%= current_user.email %></div>
              </div>
            </div>
            <%= button_to "ログアウト", logout_path, method: :delete, class: "btn btn-sm sidebar-logout" %>
          </div>
        </nav>

        <div class="main-area">
          <% if notice.present? %>
            <div class="flash flash-notice"><%= notice %></div>
          <% end %>
          <% if alert.present? %>
            <div class="flash flash-alert"><%= alert %></div>
          <% end %>

          <%= yield %>
        </div>
      </div>
    <% else %>
      <%= yield %>
    <% end %>
  </body>
</html>
