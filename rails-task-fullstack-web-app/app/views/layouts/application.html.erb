<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rails Task App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="app-frame">
      <nav class="sidebar">
        <div class="sidebar-header">Rails Task App</div>
        <div class="sidebar-nav">
          <%= link_to projects_path, class: "sidebar-item #{'active' if controller_name == 'projects' || controller_name == 'tasks'}" do %>
            Projects
          <% end %>
        </div>
      </nav>

      <div class="main-area">
        <% if notice.present? %>
          <div class="flash flash-notice"><%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="flash flash-alert"><%= alert %></div>
        <% end %>

        <%= yield %>
      </div>
    </div>
  </body>
</html>
