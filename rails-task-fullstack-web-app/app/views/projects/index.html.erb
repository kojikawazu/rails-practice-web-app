<div class="page-header">
  <h1>プロジェクト一覧</h1>
  <%= link_to "新規作成", new_project_path, class: "btn btn-primary" %>
</div>

<table>
  <thead>
    <tr>
      <th>プロジェクト名</th>
      <th>説明</th>
      <th>タスク数</th>
      <th>作成日</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @projects.each do |project| %>
      <%# 行クリックで詳細へ。CSP でインライン onclick を許可しないため Stimulus に委ねる。 %>
      <tr class="row-link" data-controller="row-link" data-action="click->row-link#navigate"
          data-row-link-url-value="<%= project_path(project) %>">
        <td><strong><%= project.title %></strong></td>
        <td class="text-sub"><%= truncate(project.description, length: 50) %></td>
        <td><span class="badge badge-grey"><%= project.tasks_count %></span></td>
        <td class="text-sub"><%= project.created_at.strftime("%Y-%m-%d") %></td>
        <td>
          <%= link_to "編集", edit_project_path(project), class: "btn btn-sm" %>
          <%= link_to "複製", duplicate_project_path(project), class: "btn btn-sm" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
