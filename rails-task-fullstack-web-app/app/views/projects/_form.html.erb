<% if project.errors.any? %>
  <div class="error-messages">
    <ul>
      <% project.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with(model: project, class: "card", style: "max-width:600px;") do |form| %>
  <div class="form-group">
    <%= form.label :title, "タイトル" %>
    <%= form.text_field :title, class: "form-input", placeholder: "プロジェクト名を入力（100文字以内）" %>
  </div>

  <div class="form-group">
    <%= form.label :description, "説明" %>
    <%= form.text_area :description, class: "form-textarea", placeholder: "プロジェクトの概要を入力" %>
  </div>

  <div class="flex gap-sm" style="margin-top:24px;">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "キャンセル", project.persisted? ? project_path(project) : projects_path, class: "btn" %>
  </div>
<% end %>
