<% if project.errors.any? %>
  <div class="error-messages">
    <ul>
      <% project.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# Turbo Drive の扱い:
    新規 = (b案2) リダイレクト方式（confirm が 303 を返すため Turbo 有効・白画面なし）、
    編集 = 従来のフルページ遷移（confirm が 200 で確認画面を返すため turbo:false）。 %>
<%= form_with(model: project, method: :post,
      url: project.persisted? ? confirm_project_path(project) : confirm_projects_path,
      data: project.persisted? ? { turbo: false } : {},
      class: "card", style: "max-width:600px;") do |form| %>
  <div class="form-group">
    <%= form.label :title, "タイトル" %>
    <%= form.text_field :title, class: "form-input", placeholder: "プロジェクト名を入力（100文字以内）" %>
  </div>

  <div class="form-group">
    <%= form.label :description, "説明" %>
    <%= form.text_area :description, class: "form-textarea", placeholder: "プロジェクトの概要を入力" %>
  </div>

  <div class="flex gap-sm" style="margin-top:24px;">
    <%= form.submit "確認する", class: "btn btn-primary" %>
    <%= link_to "キャンセル", project.persisted? ? project_path(project) : projects_path, class: "btn" %>
  </div>
<% end %>
