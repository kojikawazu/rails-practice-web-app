<div class="auth-container">
  <div class="auth-logo">Rails Task App</div>
  <p class="auth-sub">プロジェクト・タスクを管理する</p>

  <% if flash[:alert] %>
    <div class="flash flash-alert"><%= flash[:alert] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="flash flash-notice"><%= flash[:notice] %></div>
  <% end %>

  <div class="card">
    <h2 style="font-size:18px; margin-bottom:20px;">ログイン</h2>
    <%= form_with(url: login_path, method: :post) do |form| %>
      <div class="form-group">
        <%= form.label :email, "メールアドレス" %>
        <%= form.email_field :email, class: "form-input", placeholder: "user@example.com" %>
      </div>
      <div class="form-group">
        <%= form.label :password, "パスワード" %>
        <%= form.password_field :password, class: "form-input", placeholder: "6文字以上" %>
      </div>
      <%= form.submit "ログイン", class: "btn btn-primary", style: "width:100%; margin-top:8px;" %>
    <% end %>

    <hr style="margin:24px 0; border:none; border-top:1px solid #e2e8f0;">
    <p style="text-align:center; font-size:14px; color:#64748b;">
      アカウントをお持ちでない方は <%= link_to "新規登録", signup_path %>
    </p>
  </div>
</div>
