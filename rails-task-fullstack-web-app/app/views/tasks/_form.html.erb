<% if task.errors.any? %>
  <div class="error-messages">
    <ul>
      <% task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# 確認画面は POST に対し別ページを 200 で描画するため、Turbo Drive を無効化してフルページ遷移にする。 %>
<%= form_with(model: [@project, task], method: :post,
      url: task.persisted? ? confirm_project_task_path(@project, task) : confirm_project_tasks_path(@project),
      data: { turbo: false },
      class: "card", style: "max-width:600px;") do |form| %>
  <div class="form-group">
    <%= form.label :title, "タイトル" %>
    <%= form.text_field :title, class: "form-input", placeholder: "タスク名を入力（200文字以内）" %>
  </div>

  <div class="form-group">
    <%= form.label :status, "ステータス" %>
    <%= form.select :status, Task.statuses.keys.map { |s| [I18n.t("task_status.#{s}", default: s.humanize), s] }, {}, class: "form-select" %>
  </div>

  <%# 開始日・終了日は flatpickr（type=text）で選択する。ラッパーに data-controller を付け、
      開始/終了の input を start/end ターゲットとして flatpickr_controller に渡す。 %>
  <div class="flex gap-sm" data-controller="flatpickr">
    <div class="form-group" style="flex:1;">
      <%= form.label :start_date, "開始日" %>
      <%= form.text_field :start_date, class: "form-input", autocomplete: "off",
            placeholder: "YYYY-MM-DD", data: { flatpickr_target: "start" } %>
    </div>
    <div class="form-group" style="flex:1;">
      <%= form.label :end_date, "終了日" %>
      <%= form.text_field :end_date, class: "form-input", autocomplete: "off",
            placeholder: "YYYY-MM-DD", data: { flatpickr_target: "end" } %>
    </div>
  </div>

  <div class="flex gap-sm" style="margin-top:24px;">
    <%= form.submit "確認する", class: "btn btn-primary" %>
    <%= link_to "キャンセル", project_path(@project), class: "btn" %>
  </div>
<% end %>
