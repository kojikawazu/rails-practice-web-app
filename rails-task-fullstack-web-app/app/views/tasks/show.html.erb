<div style="font-size:12px; margin-bottom:4px;"><%= link_to "← #{@project.title}", project_path(@project) %></div>

<div class="page-header">
  <h1><%= @task.title %></h1>
  <div class="flex gap-sm">
    <%= link_to "編集", edit_project_task_path(@project, @task), class: "btn" %>
    <%= link_to "複製", duplicate_project_task_path(@project, @task), class: "btn" %>
    <%= button_to "削除", project_task_path(@project, @task), method: :delete, class: "btn btn-danger",
        data: { turbo_confirm: "このタスクを削除しますか？" } %>
  </div>
</div>

<div class="card" style="max-width:600px;">
  <div style="display:grid; grid-template-columns:120px 1fr; gap:12px 16px; font-size:14px;">
    <div class="text-sub" style="font-weight:600;">タイトル</div>
    <div><%= @task.title %></div>

    <div class="text-sub" style="font-weight:600;">ステータス</div>
    <div>
      <% case @task.status %>
      <% when "completed" %>
        <span class="badge badge-green">完了</span>
      <% when "in_progress" %>
        <span class="badge badge-yellow">進行中</span>
      <% else %>
        <span class="badge badge-grey">未着手</span>
      <% end %>
    </div>

    <div class="text-sub" style="font-weight:600;">期日</div>
    <div><%= @task.due_date&.strftime("%Y-%m-%d") || "-" %></div>

    <div class="text-sub" style="font-weight:600;">プロジェクト</div>
    <div><%= link_to @project.title, project_path(@project) %></div>

    <div class="text-sub" style="font-weight:600;">作成日</div>
    <div class="text-muted"><%= @task.created_at.strftime("%Y-%m-%d") %></div>

    <div class="text-sub" style="font-weight:600;">更新日</div>
    <div class="text-muted"><%= @task.updated_at.strftime("%Y-%m-%d") %></div>
  </div>
</div>
