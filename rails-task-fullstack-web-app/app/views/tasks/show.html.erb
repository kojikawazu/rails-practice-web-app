<div style="font-size:12px; margin-bottom:4px;"><%= link_to "← #{@project.title}", project_path(@project) %></div>

<div class="page-header">
  <h1><%= @task.title %></h1>
  <div class="flex gap-sm">
    <%= link_to "編集", edit_project_task_path(@project, @task), class: "btn" %>
    <%= link_to "複製", duplicate_project_task_path(@project, @task), class: "btn" %>
    <%= button_to "削除", project_task_path(@project, @task), method: :delete, class: "btn btn-danger",
        data: { turbo_confirm: "このタスクを削除しますか？" } %>
  </div>
</div>

<div class="card" style="max-width:600px;">
  <div style="display:grid; grid-template-columns:120px 1fr; gap:12px 16px; font-size:14px;">
    <div class="text-sub" style="font-weight:600;">タイトル</div>
    <div><%= @task.title %></div>

    <div class="text-sub" style="font-weight:600;">ステータス</div>
    <div>
      <% case @task.status %>
      <% when "completed" %>
        <span class="badge badge-green">完了</span>
      <% when "in_progress" %>
        <span class="badge badge-yellow">進行中</span>
      <% else %>
        <span class="badge badge-grey">未着手</span>
      <% end %>
    </div>

    <div class="text-sub" style="font-weight:600;">開始日</div>
    <div><%= @task.start_date&.strftime("%Y-%m-%d") || "-" %></div>

    <div class="text-sub" style="font-weight:600;">終了日</div>
    <div><%= @task.end_date&.strftime("%Y-%m-%d") || "-" %></div>

    <div class="text-sub" style="font-weight:600;">プロジェクト</div>
    <div><%= link_to @project.title, project_path(@project) %></div>

    <div class="text-sub" style="font-weight:600;">作成日</div>
    <div class="text-muted"><%= @task.created_at.strftime("%Y-%m-%d") %></div>

    <div class="text-sub" style="font-weight:600;">更新日</div>
    <div class="text-muted"><%= @task.updated_at.strftime("%Y-%m-%d") %></div>
  </div>
</div>

<%# ===== 添付画像 ===== %>
<div class="card mt-md" style="max-width:600px;">
  <h2 style="font-size:16px; margin-bottom:12px;">添付画像</h2>

  <% if @task.images.attached? %>
    <div class="flex gap-sm" style="flex-wrap:wrap;">
      <% @task.images.each do |image| %>
        <div style="position:relative; width:120px;">
          <%= image_tag image.variant(resize_to_limit: [120, 120]),
                style: "width:120px; height:120px; object-fit:cover; border-radius:6px; border:1px solid #e2e8f0;" %>
          <%= button_to "×", detach_image_project_task_path(@project, @task, image.id),
                method: :delete, class: "btn btn-sm btn-danger",
                style: "position:absolute; top:4px; right:4px; padding:2px 8px;",
                data: { turbo_confirm: "この画像を削除しますか？" } %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted" style="font-size:13px;">まだ画像はありません。</p>
  <% end %>

  <%# 画像の追加は編集フォームから行う（確認画面フローに合流）。 %>
  <div style="margin-top:16px;">
    <%= link_to "画像を追加・編集", edit_project_task_path(@project, @task), class: "btn btn-sm" %>
  </div>
</div>
