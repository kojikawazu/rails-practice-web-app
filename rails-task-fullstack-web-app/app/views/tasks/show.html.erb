<div class="breadcrumb"><%= link_to "← #{@project.title}", project_path(@project) %></div>

<div class="page-header">
  <h1><%= @task.title %></h1>
  <div class="flex gap-sm">
    <%= link_to "編集", edit_project_task_path(@project, @task), class: "btn" %>
    <%= link_to "複製", duplicate_project_task_path(@project, @task), class: "btn" %>
    <%= button_to "削除", project_task_path(@project, @task), method: :delete, class: "btn btn-danger",
        data: { turbo_confirm: "このタスクを削除しますか？" } %>
  </div>
</div>

<div class="card card-narrow">
  <div class="detail-list">
    <div class="text-sub detail-label">タイトル</div>
    <div><%= @task.title %></div>

    <div class="text-sub detail-label">ステータス</div>
    <div>
      <% case @task.status %>
      <% when "completed" %>
        <span class="badge badge-green">完了</span>
      <% when "in_progress" %>
        <span class="badge badge-yellow">進行中</span>
      <% else %>
        <span class="badge badge-grey">未着手</span>
      <% end %>
    </div>

    <div class="text-sub detail-label">開始日</div>
    <div><%= @task.start_date&.strftime("%Y-%m-%d") || "-" %></div>

    <div class="text-sub detail-label">終了日</div>
    <div><%= @task.end_date&.strftime("%Y-%m-%d") || "-" %></div>

    <div class="text-sub detail-label">プレビュー URL</div>
    <div>
      <% if @task.preview_url.present? %>
        <%# 詳細画面では iframe を出さず、安全なリンクのみ（rel=noopener noreferrer）。 %>
        <%= link_to @task.preview_url, @task.preview_url, target: "_blank", rel: "noopener noreferrer" %>
      <% else %>
        -
      <% end %>
    </div>

    <div class="text-sub detail-label">プロジェクト</div>
    <div><%= link_to @project.title, project_path(@project) %></div>

    <div class="text-sub detail-label">作成日</div>
    <div class="text-muted"><%= @task.created_at.strftime("%Y-%m-%d") %></div>

    <div class="text-sub detail-label">更新日</div>
    <div class="text-muted"><%= @task.updated_at.strftime("%Y-%m-%d") %></div>
  </div>
</div>

<%# ===== 添付画像 ===== %>
<div class="card card-narrow mt-md">
  <h2 class="section-title">添付画像</h2>

  <% if @task.images.attached? %>
    <div class="thumb-list">
      <% @task.images.each do |image| %>
        <div class="thumb-item">
          <%= image_tag image.variant(resize_to_limit: [120, 120]),
                class: "thumb" %>
          <%= button_to "×", detach_image_project_task_path(@project, @task, image.id),
                method: :delete, class: "btn btn-sm btn-danger thumb-remove",
                data: { turbo_confirm: "この画像を削除しますか？" } %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted text-sm">まだ画像はありません。</p>
  <% end %>

  <%# 画像の追加は編集フォームから行う（確認画面フローに合流）。 %>
  <div class="mt-md">
    <%= link_to "画像を追加・編集", edit_project_task_path(@project, @task), class: "btn btn-sm" %>
  </div>
</div>
