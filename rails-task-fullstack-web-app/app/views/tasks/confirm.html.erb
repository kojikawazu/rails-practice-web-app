<div class="page-header">
  <h1>入力内容の確認</h1>
</div>

<p class="text-sub mb-md">以下の内容で<%= @task.persisted? ? "更新" : "作成" %>します。よろしければ「<%= @task.persisted? ? "更新する" : "作成する" %>」を押してください。</p>

<div class="card card-narrow">
  <div class="detail-list">
    <div class="text-sub detail-label">タイトル</div>
    <div><%= @task.title %></div>

    <div class="text-sub detail-label">ステータス</div>
    <div>
      <% case @task.status %>
      <% when "completed" %>
        <span class="badge badge-green">完了</span>
      <% when "in_progress" %>
        <span class="badge badge-yellow">進行中</span>
      <% else %>
        <span class="badge badge-grey">未着手</span>
      <% end %>
    </div>

    <div class="text-sub detail-label">開始日</div>
    <div><%= @task.start_date&.strftime("%Y-%m-%d") || "-" %></div>

    <div class="text-sub detail-label">終了日</div>
    <div><%= @task.end_date&.strftime("%Y-%m-%d") || "-" %></div>

    <div class="text-sub detail-label">プレビュー URL</div>
    <div>
      <% if @task.preview_url.present? %>
        <%# モデルで http/https のみ許可済み。iframe は最小権限の sandbox で隔離する。 %>
        <div><%= link_to @task.preview_url, @task.preview_url, target: "_blank", rel: "noopener noreferrer" %></div>
        <%# allow-same-origin は外部サイトを正常表示するため。自ホスト/内部アドレスはモデルで拒否済みのため
            脱獄経路は塞がれている。allow-top-navigation/popups/forms/modals は付けない。 %>
        <iframe src="<%= @task.preview_url %>"
                sandbox="allow-scripts allow-same-origin"
                referrerpolicy="no-referrer"
                allow=""
                loading="lazy"
                title="プレビュー"
                class="preview-frame"></iframe>
        <div class="hint">
          ※ サイトによっては埋め込みが許可されておらず、表示されない場合があります（上のリンクから開けます）。
        </div>
      <% else %>
        <span class="text-muted">-</span>
      <% end %>
    </div>

    <div class="text-sub detail-label">添付画像</div>
    <div>
      <% remove_ids = Array(@remove_attachment_ids).map(&:to_s) %>
      <% kept = @task.persisted? ? @task.images.reject { |img| remove_ids.include?(img.id.to_s) } : [] %>
      <% pending = Array(@staged_blobs) %>
      <% if kept.any? || pending.any? %>
        <div class="thumb-list">
          <% kept.each do |image| %>
            <%= image_tag image.variant(resize_to_limit: [80, 80]),
                  class: "thumb-sm" %>
          <% end %>
          <% pending.each do |blob| %>
            <%# 新規アップロードは確認ステップで blob 化済み。kept と同様にサムネイル表示する。 %>
            <%# 「新規」はキャプションで示し、未保存（確定で attach される）であることを明示する。 %>
            <figure class="thumb-new">
              <% if blob.representable? %>
                <%= image_tag blob.variant(resize_to_limit: [80, 80]),
                      alt: blob.filename, title: blob.filename,
                      class: "thumb-sm" %>
              <% else %>
                <span class="badge badge-grey" title="<%= blob.filename %>"><%= blob.filename %></span>
              <% end %>
              <figcaption class="badge badge-grey thumb-caption">新規</figcaption>
            </figure>
          <% end %>
        </div>
      <% else %>
        <span class="text-muted">なし</span>
      <% end %>
      <% if @task.persisted? && remove_ids.any? %>
        <div class="hint">
          削除予定: <%= @task.images.select { |img| remove_ids.include?(img.id.to_s) }.map { |img| img.filename }.join("、") %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex gap-sm form-actions">
    <%# Turbo Drive は非リダイレクトの 200 描画を破棄するため、確認画面のフォームはフルページ遷移にする。 %>
    <%# 「修正する」: 入力値を confirm へ再送(back=1)し、入力フォームへ戻す（独立フォーム）。 %>
    <%# 画像の選択（signed_id）・削除予約（remove_attachment_ids）も hidden で持ち回る。 %>
    <%= button_to "修正する",
          (@task.persisted? ? confirm_project_task_path(@project, @task) : confirm_project_tasks_path(@project)),
          method: :post,
          params: { task: { title: @task.title, status: @task.status,
                            start_date: @task.start_date, end_date: @task.end_date,
                            preview_url: @task.preview_url,
                            image_signed_ids: Array(@staged_blobs).map { |blob| staged_image_signed_id(blob) },
                            remove_attachment_ids: Array(@remove_attachment_ids) }, back: 1 },
          form: { data: { turbo: false } },
          class: "btn" %>

    <%# 「作成する/更新する」: form_with(model:) の既定送信先 create(POST) / update(PATCH) で保存する。 %>
    <%= form_with(model: [@project, @task], data: { turbo: false }) do |form| %>
      <%= form.hidden_field :title %>
      <%= form.hidden_field :status %>
      <%= form.hidden_field :start_date %>
      <%= form.hidden_field :end_date %>
      <%= form.hidden_field :preview_url %>
      <% Array(@staged_blobs).each do |blob| %>
        <%= hidden_field_tag "task[image_signed_ids][]", staged_image_signed_id(blob) %>
      <% end %>
      <% Array(@remove_attachment_ids).each do |rid| %>
        <%= hidden_field_tag "task[remove_attachment_ids][]", rid %>
      <% end %>
      <%= form.submit(@task.persisted? ? "更新する" : "作成する", class: "btn btn-primary") %>
    <% end %>
  </div>
</div>
